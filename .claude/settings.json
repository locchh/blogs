{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/clarity-gate.sh",
            "timeout": 30,
            "statusMessage": "Checking clarity stamps for published posts"
          }
        ]
      }
    ]
  }
}
